# Copier vers .env sur la VM (/opt/kolos/.env) — NE JAMAIS committer le vrai .env

NODE_ENV=production
PORT=3000

# Domaine public (Caddy + Let's Encrypt)
KOLOS_DOMAIN=kolos.example.com
ACME_EMAIL=toi@example.com

# Images Registry Scaleway (remplies par le déploiement / GHA)
# Exemple : rg.fr-par.scw.cloud/kolos/api:abc1234
KOLOS_API_IMAGE=rg.fr-par.scw.cloud/NAMESPACE/kolos-api:latest
KOLOS_WEB_IMAGE=rg.fr-par.scw.cloud/NAMESPACE/kolos-web:latest

# PostgreSQL (mot de passe FORT, ≠ dev)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kolos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=kolos_identity
POSTGRES_SSL=false

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=kolos_business

# JWT (générer avec : openssl rand -base64 48)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies / CORS — même origine via Caddy
CORS_ORIGIN=https://kolos.example.com
REFRESH_COOKIE_NAME=kolos_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Seed admin au premier démarrage uniquement (mettre false ensuite)
RUN_SEED_ON_START=true
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
