{
  "name": "@kolos/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "lint": "echo \"no lint configured\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.js",
    "typeorm:migrate": "typeorm-ts-node-commonjs migration:run -d src/shared/infrastructure/postgres/postgres.data-source.ts",
    "typeorm:migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infrastructure/postgres/postgres.data-source.ts",
    "seed:postgres": "ts-node -r tsconfig-paths/register src/shared/infrastructure/postgres/seeds/seed-admin-user.ts",
    "seed:mongo": "ts-node -r tsconfig-paths/register src/shared/infrastructure/mongo/seeds/seed-messages.ts && ts-node -r tsconfig-paths/register src/shared/infrastructure/mongo/seeds/seed-moderation-actions.ts"
  },
  "dependencies": {
    "@kolos/shared-types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "joi": "^17.13.6",
    "mongoose": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "uuid": "^11.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
